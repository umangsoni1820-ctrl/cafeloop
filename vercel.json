{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "regions": ["hnd1"],
  "functions": {
    "index.js": {
      "includeFiles": "server/postgres-schema.sql",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
