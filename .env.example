# Leave DATABASE_URL empty for local SQLite. For CafeLoop Supabase, copy the
# session-pooler URI below into DATABASE_URL and replace YOUR_DATABASE_PASSWORD.
# Percent-encode reserved characters; never share or commit the completed URI.
PORT=3001
DATABASE_URL=
# CafeLoop Supabase session pooler:
# postgresql://postgres.emgdnxopirmpisvicfei:YOUR_DATABASE_PASSWORD@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres
DATABASE_PATH=./.data/cafeloop.sqlite
APP_PUBLIC_URL=http://localhost:5173
NODE_ENV=development

# Optional Twilio integration. Scheduled messages stay queued until explicitly enabled.
# For WhatsApp, TWILIO_FROM should look like whatsapp:+14155238886.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_AUTOMATIONS_ENABLED=false
