{
  "name": "cafeloop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0 <25.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build && node scripts/copy-static-to-public.mjs",
    "start": "node server/index.js",
    "start:public-test": "node scripts/start-public-test.mjs",
    "test": "node --test test/app.test.js",
    "test:browser": "npm run build && node --test test/browser-smoke.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "postgres": "^4.1.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "playwright": "^1.65.0",
    "vite": "^6.0.7"
  }
}
